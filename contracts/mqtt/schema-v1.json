{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gruahub.com/contracts/mqtt/schema-v1.json",
  "title": "GruaHub MQTT Message Contract v1",
  "description": "Schema de mensagens trocadas entre controladores de máquina e o backend via EMQX. Política de tópicos/ACL: broker-policy-v1.json.",

  "oneOf": [
    { "$ref": "#/definitions/heartbeat" },
    { "$ref": "#/definitions/play_started" },
    { "$ref": "#/definitions/play_completed" },
    { "$ref": "#/definitions/error_report" },
    { "$ref": "#/definitions/command_ack" },
    { "$ref": "#/definitions/grant_credit_command" }
  ],

  "definitions": {
    "envelope": {
      "type": "object",
      "required": ["messageId", "schemaVersion", "tenantId", "machineId", "type", "occurredAt"],
      "properties": {
        "messageId":     { "type": "string", "format": "uuid" },
        "schemaVersion": { "type": "integer", "const": 1 },
        "tenantId":      { "type": "string", "format": "uuid" },
        "machineId":     { "type": "string", "format": "uuid" },
        "sequence":      { "type": "integer", "minimum": 0 },
        "occurredAt":    { "type": "string", "format": "date-time" },
        "type":          { "type": "string", "enum": ["heartbeat", "play_started", "play_completed", "error_report", "command_ack"] }
      }
    },

    "heartbeat": {
      "allOf": [
        { "$ref": "#/definitions/envelope" },
        {
          "type": "object",
          "required": ["payload"],
          "properties": {
            "type": { "const": "heartbeat" },
            "payload": {
              "type": "object",
              "properties": {
                "online":            { "type": "boolean" },
                "doorOpen":          { "type": "boolean" },
                "motorFault":        { "type": "boolean" },
                "creditsAvailable":  { "type": "integer", "minimum": 0 },
                "uptimeSeconds":     { "type": "integer", "minimum": 0 },
                "firmwareVersion":   { "type": "string" }
              }
            }
          }
        }
      ]
    },

    "play_started": {
      "allOf": [
        { "$ref": "#/definitions/envelope" },
        {
          "type": "object",
          "required": ["payload"],
          "properties": {
            "type": { "const": "play_started" },
            "payload": {
              "type": "object",
              "required": ["creditGrantId", "playSessionId"],
              "properties": {
                "creditGrantId":  { "type": "string", "format": "uuid" },
                "playSessionId":  { "type": "string", "format": "uuid" }
              }
            }
          }
        }
      ]
    },

    "play_completed": {
      "allOf": [
        { "$ref": "#/definitions/envelope" },
        {
          "type": "object",
          "required": ["payload"],
          "properties": {
            "type": { "const": "play_completed" },
            "payload": {
              "type": "object",
              "required": ["playSessionId", "prizeDelivered"],
              "properties": {
                "playSessionId":   { "type": "string", "format": "uuid" },
                "creditGrantId":   { "type": "string", "format": "uuid" },
                "prizeDelivered":  { "type": "boolean" },
                "durationSeconds": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      ]
    },

    "error_report": {
      "allOf": [
        { "$ref": "#/definitions/envelope" },
        {
          "type": "object",
          "required": ["payload"],
          "properties": {
            "type": { "const": "error_report" },
            "payload": {
              "type": "object",
              "required": ["errorCode"],
              "properties": {
                "errorCode":     { "type": "string" },
                "errorMessage":  { "type": "string" },
                "doorOpen":      { "type": "boolean" },
                "motorFault":    { "type": "boolean" }
              }
            }
          }
        }
      ]
    },

    "command_ack": {
      "allOf": [
        { "$ref": "#/definitions/envelope" },
        {
          "type": "object",
          "required": ["payload"],
          "properties": {
            "type": { "const": "command_ack" },
            "payload": {
              "type": "object",
              "required": ["commandId", "commandType", "success"],
              "properties": {
                "commandId":     { "type": "string", "format": "uuid" },
                "commandType":   { "type": "string", "enum": ["GRANT_CREDIT", "REBOOT", "LOCK", "UNLOCK", "UPDATE_CONFIG"] },
                "creditGrantId": { "type": "string", "format": "uuid" },
                "success":       { "type": "boolean" },
                "failureReason": { "type": "string" }
              }
            }
          }
        }
      ]
    },

    "grant_credit_command": {
      "type": "object",
      "required": ["commandId", "commandType", "creditGrantId", "playsGranted", "ttlSeconds"],
      "properties": {
        "commandId":     { "type": "string", "format": "uuid" },
        "commandType":   { "const": "GRANT_CREDIT" },
        "creditGrantId": { "type": "string", "format": "uuid" },
        "playsGranted":  { "type": "integer", "minimum": 1 },
        "ttlSeconds":    { "type": "integer", "minimum": 1, "maximum": 300 }
      }
    }
  }
}
