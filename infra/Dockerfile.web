FROM node:20-alpine AS builder
WORKDIR /build
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:20-alpine AS runtime
RUN addgroup -S gruahub && adduser -S gruahub -G gruahub
USER gruahub
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder --chown=gruahub:gruahub /build/.next/standalone ./
COPY --from=builder --chown=gruahub:gruahub /build/.next/static ./.next/static
COPY --from=builder --chown=gruahub:gruahub /build/public ./public
EXPOSE 3000
STOPSIGNAL SIGTERM
CMD ["node", "server.js"]
