FROM node:20-alpine AS builder
WORKDIR /build
ARG NEXT_PUBLIC_API_URL=http://localhost:8080
ARG NEXT_PUBLIC_SANDBOX_ENABLED=true
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SANDBOX_ENABLED=$NEXT_PUBLIC_SANDBOX_ENABLED
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:20-alpine AS runtime
RUN addgroup -S gruahub && adduser -S gruahub -G gruahub
USER gruahub
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder --chown=gruahub:gruahub /build/.next/standalone ./
COPY --from=builder --chown=gruahub:gruahub /build/.next/static ./.next/static
COPY --from=builder --chown=gruahub:gruahub /build/public ./public
EXPOSE 3000
STOPSIGNAL SIGTERM
CMD ["sh", "-c", "if [ -f /scripts/load-secret-files.sh ]; then . /scripts/load-secret-files.sh; fi; exec node server.js"]
