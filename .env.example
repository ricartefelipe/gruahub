# ─────────────────────────────────────────────────────────────────────────────
# GruaHub — Variáveis de ambiente de exemplo
# NUNCA commite valores reais neste arquivo.
# Copie para .env e preencha com valores reais para desenvolvimento local.
# Em produção, use um secret store (ex: AWS Secrets Manager, Vault, K8s Secrets).
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=gruahub
POSTGRES_USER=gruahub
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ── Keycloak ───────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ── EMQX ──────────────────────────────────────────────────────────────────────
EMQX_BACKEND_PASSWORD=CHANGE_ME_IN_PRODUCTION
EMQX_DEVICE_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ── Backend (Quarkus) ─────────────────────────────────────────────────────────
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://localhost:5432/gruahub
QUARKUS_DATASOURCE_USERNAME=gruahub
QUARKUS_DATASOURCE_PASSWORD=CHANGE_ME_IN_PRODUCTION

QUARKUS_OIDC_AUTH_SERVER_URL=http://localhost:8180/realms/gruahub
QUARKUS_OIDC_CLIENT_ID=gruahub-backend

GRUAHUB_MQTT_BROKER_URL=tcp://localhost:1883
GRUAHUB_MQTT_USERNAME=gruahub-backend
GRUAHUB_MQTT_PASSWORD=CHANGE_ME_IN_PRODUCTION

QUARKUS_S3_ENDPOINT_OVERRIDE=http://localhost:9000
AWS_ACCESS_KEY_ID=CHANGE_ME_IN_PRODUCTION
AWS_SECRET_ACCESS_KEY=CHANGE_ME_IN_PRODUCTION

# Sandbox (somente demo/dev — manter false em produção)
GRUAHUB_SANDBOX_ENABLED=false
GRUAHUB_SANDBOX_WEBHOOK_SECRET=CHANGE_ME_IN_PRODUCTION
SANDBOX_SECRET=CHANGE_ME_IN_PRODUCTION

# ── Frontend Web (Next.js) ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_IN_PRODUCTION

KEYCLOAK_ID=gruahub-web
KEYCLOAK_SECRET=CHANGE_ME_IN_PRODUCTION
KEYCLOAK_ISSUER=http://localhost:8180/realms/gruahub

# ── Mobile (Expo) ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_KEYCLOAK_URL=http://localhost:8180
EXPO_PUBLIC_KEYCLOAK_REALM=gruahub
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=gruahub-mobile

# ── Simuladores ───────────────────────────────────────────────────────────────
MQTT_BROKER_URL=mqtt://localhost:1883
TENANT_ID=11111111-0000-0000-0000-000000000001
MACHINE_IDS=MAQUINA-001,MAQUINA-003,MAQUINA-005
HEARTBEAT_INTERVAL_MS=30000
PAYMENT_API_URL=http://localhost:8080
SANDBOX_WEBHOOK_SECRET=CHANGE_ME_IN_PRODUCTION
