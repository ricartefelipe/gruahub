# Valores apenas para demo/local. Copie para infra/.env antes do compose.
# Em produção use Secret Manager / Vault — nunca reutilize estes valores.

POSTGRES_DB=gruahub
POSTGRES_USER=gruahub
POSTGRES_PASSWORD=gruahub
POSTGRES_PORT=5432

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=gruahub
KEYCLOAK_CLIENT_ID=gruahub-backend
KEYCLOAK_CLIENT_SECRET=gruahub-backend-secret
# Hostname público do Keycloak (overlay prod-like / edge Caddy). Defaults no overlay.
# KC_HOSTNAME=auth.localhost
# KC_PROXY_HEADERS=xforwarded
# KC_HOSTNAME_BACKCHANNEL_DYNAMIC=true

EMQX_DASHBOARD_USERNAME=admin
# EMQX 5 exige senha do dashboard com 8-64 caracteres.
EMQX_DASHBOARD_PASSWORD=public12

MQTT_BROKER_URL=tcp://emqx:1883
MQTT_USERNAME=gruahub-backend
MQTT_PASSWORD=gruahub-backend-pass
MQTT_SIM_USERNAME=sim-machine
MQTT_SIM_PASSWORD=sim-machine-pass
MQTT_HEARTBEAT_TIMEOUT_SECONDS=120

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gruahub

DB_HOST=postgres
DB_PORT=5432
DB_NAME=gruahub
DB_USER=gruahub
DB_PASSWORD=gruahub

# Demo local: true. Piloto/produção pública: false (obrigatório).
GRUAHUB_SANDBOX_ENABLED=true
GRUAHUB_SANDBOX_WEBHOOK_SECRET=sandbox-webhook-secret-gruahub-demo
SANDBOX_SECRET=sandbox-webhook-secret-gruahub-demo
# Override explícito só se precisar sandbox em profile prod (não use em piloto público).
GRUAHUB_PROD_ALLOW_SANDBOX=false
# Fail-fast em profile prod / overlay prod-like quando sandbox estiver ligado.
GRUAHUB_PROD_ENFORCE_SAFETY=false
# PWA /api/v1/public/* — true em demo; em piloto público ligue só se o fluxo do jogador estiver ativo.
GRUAHUB_PLAYER_PUBLIC_ENABLED=true

GRUAHUB_PAYMENT_PROVIDER=sandbox
# GRUAHUB_PAYMENT_MERCADOPAGO_ACCESS_TOKEN=
# GRUAHUB_PAYMENT_MERCADOPAGO_WEBHOOK_SECRET=
# GRUAHUB_PAYMENT_MERCADOPAGO_NOTIFICATION_URL=https://api.example.com/api/v1/payments/webhook/mercadopago
# MP_PAYER_EMAIL=pagamentos@gruahub.local

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=gruahub-nextauth-secret-local-only
NEXT_PUBLIC_API_URL=http://localhost:8080
KEYCLOAK_ISSUER=http://localhost:8180/realms/gruahub
KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/realms/gruahub
KEYCLOAK_CLIENT_ID_WEB=gruahub-web
KEYCLOAK_CLIENT_SECRET_WEB=gruahub-web-secret

TENANT_ID=11111111-0000-0000-0000-000000000001
MACHINE_IDS=66666666-0000-0000-0000-000000000001,66666666-0000-0000-0000-000000000003
MACHINE_ID=66666666-0000-0000-0000-000000000001
HEARTBEAT_INTERVAL_MS=30000

LOG_JSON=true
# Demo local: demo. Piloto/produção: deixe vazio (sem seed demo / senhas conhecidas).
QUARKUS_LIQUIBASE_CONTEXTS=demo
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317

GRUAHUB_RATE_LIMIT_WEBHOOK_MAX=30
GRUAHUB_RATE_LIMIT_SANDBOX_MAX=60
GRUAHUB_RATE_LIMIT_WINDOW_SECONDS=60
GRUAHUB_RATE_LIMIT_GLOBAL_ENABLED=true
GRUAHUB_RATE_LIMIT_GLOBAL_MAX=300
GRUAHUB_RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60

GRUAHUB_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://localhost

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7

# Push: noop | http-stub | expo — ver docs/DEPLOYMENT.md
GRUAHUB_PUSH_PROVIDER=noop
# GRUAHUB_PUSH_HTTP_STUB_URL=http://host.docker.internal:9999/push-stub
# GRUAHUB_PUSH_PROVIDER=expo
# GRUAHUB_PUSH_EXPO_URL=https://exp.host/--/api/v2/push/send

# Offsite opcional (S3-compatible: MinIO local ou AWS). Vazio = só volume local.
# BACKUP_S3_ENDPOINT=http://minio:9000
# BACKUP_S3_ACCESS_KEY=minioadmin
# BACKUP_S3_SECRET_KEY=minioadmin
# BACKUP_S3_BUCKET=gruahub
# BACKUP_S3_PREFIX=postgres-backups
# BACKUP_S3_REGION=us-east-1

# Docker secrets style: se VAR estiver vazio e VAR_FILE apontar para um arquivo, o entrypoint carrega.
# Ex.: DB_PASSWORD_FILE=/run/secrets/db_password
# DB_PASSWORD_FILE=
# KEYCLOAK_CLIENT_SECRET_FILE=
# NEXTAUTH_SECRET_FILE=
# KEYCLOAK_CLIENT_SECRET_WEB_FILE=
# POSTGRES_PASSWORD_FILE=
# BACKUP_S3_ACCESS_KEY_FILE=
# BACKUP_S3_SECRET_KEY_FILE=

# --- prod-like (overlay docker-compose.prod-like.yml) ---
# Com ./scripts/up-prod-like.sh up -d: web/API/OIDC só via Caddy (80/443).
# Keycloak NÃO publica :8180 no host; use https://auth.localhost
# NEXTAUTH_URL=https://localhost
# NEXT_PUBLIC_API_URL=https://localhost
# GRUAHUB_CORS_ORIGINS=https://localhost
# Issuer no edge (não reutiliza KEYCLOAK_ISSUER do modo :8180):
# KEYCLOAK_EDGE_ISSUER=https://auth.localhost/realms/gruahub
# EXPO_PUBLIC_KEYCLOAK_URL=https://auth.localhost
#
# Demo HTTP direto (sem overlay): browser/web em :8180.
# KEYCLOAK_ISSUER=http://localhost:8180/realms/gruahub
# Backend demo aceita qualquer iss (localhost + IP LAN / Expo Go):
# QUARKUS_OIDC_TOKEN_ISSUER=any
#
# DNS real + Let's Encrypt: ver infra/caddy/Caddyfile.public.example e docs/DEPLOYMENT.md
# KEYCLOAK_EDGE_ISSUER=https://auth.exemplo.com/realms/gruahub

# Monitoramento local: docker compose --profile monitoring up -d → http://localhost:3002
