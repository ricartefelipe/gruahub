# ─────────────────────────────────────────────────────────────────────────────
# GruaHub — Variáveis de ambiente de exemplo (apps locais fora do compose)
# NUNCA commite valores reais neste arquivo.
# Para o stack Docker: copie infra/.env.example → infra/.env (fonte canônica).
# Em produção, use Vault / AWS Secrets Manager / Docker Secrets — não .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=gruahub
POSTGRES_USER=gruahub
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ── Keycloak ───────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION
# Apps no host (sem compose edge): :8180. Prod-like/compose edge: https://auth.localhost
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=gruahub
KEYCLOAK_CLIENT_ID=gruahub-backend
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_IN_PRODUCTION
# Prod-like (Compose overlay): KEYCLOAK_EDGE_ISSUER=https://auth.localhost/realms/gruahub

# ── EMQX / MQTT ───────────────────────────────────────────────────────────────
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=CHANGE_ME_IN_PRODUCTION
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_USERNAME=gruahub-backend
MQTT_PASSWORD=CHANGE_ME_IN_PRODUCTION
MQTT_SIM_USERNAME=sim-machine
MQTT_SIM_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_IN_PRODUCTION
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME_IN_PRODUCTION
MINIO_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
MINIO_BUCKET=gruahub

# ── Backend (Quarkus) ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gruahub
DB_USER=gruahub
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION

GRUAHUB_SANDBOX_ENABLED=false
GRUAHUB_SANDBOX_WEBHOOK_SECRET=CHANGE_ME_IN_PRODUCTION
SANDBOX_SECRET=CHANGE_ME_IN_PRODUCTION

GRUAHUB_RATE_LIMIT_WEBHOOK_MAX=30
GRUAHUB_RATE_LIMIT_SANDBOX_MAX=60
GRUAHUB_RATE_LIMIT_WINDOW_SECONDS=60
GRUAHUB_RATE_LIMIT_GLOBAL_ENABLED=true
GRUAHUB_RATE_LIMIT_GLOBAL_MAX=300
GRUAHUB_RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
GRUAHUB_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://localhost

# ── Frontend Web (Next.js) ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_IN_PRODUCTION
KEYCLOAK_ISSUER=http://localhost:8180/realms/gruahub
KEYCLOAK_CLIENT_ID_WEB=gruahub-web
KEYCLOAK_CLIENT_SECRET_WEB=CHANGE_ME_IN_PRODUCTION

# ── Mobile (Expo) ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:8080
# Prod-like: https://auth.localhost (sem :8180 no host)
EXPO_PUBLIC_KEYCLOAK_URL=http://localhost:8180
EXPO_PUBLIC_KEYCLOAK_REALM=gruahub
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=gruahub-mobile

# ── Simuladores ───────────────────────────────────────────────────────────────
TENANT_ID=11111111-0000-0000-0000-000000000001
MACHINE_IDS=66666666-0000-0000-0000-000000000001,66666666-0000-0000-0000-000000000003
MACHINE_ID=66666666-0000-0000-0000-000000000001
HEARTBEAT_INTERVAL_MS=30000

# ── Backup Postgres (profile backup / prod-like) ──────────────────────────────
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7
# Offsite S3-compatible (opcional) e *_FILE: ver infra/.env.example e docs/DEPLOYMENT.md

# ── Push (stub — não é FCM Google completo) ────────────────────────────────────
# noop = só log | http-stub = POST JSON em GRUAHUB_PUSH_HTTP_STUB_URL
GRUAHUB_PUSH_PROVIDER=noop
# GRUAHUB_PUSH_HTTP_STUB_URL=https://webhook.site/your-id

# ── Observability ─────────────────────────────────────────────────────────────
LOG_JSON=true
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
# Profile Compose monitoring: Uptime Kuma em http://localhost:3002
