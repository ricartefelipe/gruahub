# Copie para mobile/.env antes de `npx expo start`.
# Este arquivo é versionado; mobile/.env NÃO é commitado.

EXPO_PUBLIC_KEYCLOAK_REALM=gruahub
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=gruahub-mobile

# --- Emulador Android / iOS Simulator / web (localhost) ---
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_KEYCLOAK_URL=http://localhost:8180

# --- Device físico (Expo Go na mesma LAN) ---
# Troque HOST_LAN_IP pelo IPv4 do PC (ex.: 192.168.15.15).
# Confira com: hostname -I | awk '{print $1}'
# EXPO_PUBLIC_API_URL=http://HOST_LAN_IP:8080
# EXPO_PUBLIC_KEYCLOAK_URL=http://HOST_LAN_IP:8180
#
# Exemplo:
# EXPO_PUBLIC_API_URL=http://192.168.15.15:8080
# EXPO_PUBLIC_KEYCLOAK_URL=http://192.168.15.15:8180
#
# Backend local (docker compose): QUARKUS_OIDC_TOKEN_ISSUER=any (padrão)
# para aceitar tokens com iss=IP e iss=localhost ao mesmo tempo.
# Keycloak client gruahub-mobile: public + PKCE; redirect URIs exp://* e gruahub://*.
# Usuários precisam da role realm offline_access (seed já inclui) para scope offline_access.

# --- EAS / push (piloto instalável) ---
# Gere com: cd mobile && npx eas init
# EXPO_PUBLIC_EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#
# Build interno Android:
#   npm run build:android-preview
# (requer login Expo: npx eas login)
