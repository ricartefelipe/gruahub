# ================================================================
# GruaHub — Variáveis de ambiente de exemplo
# NUNCA commitar este arquivo com valores reais!
# Copie para .env e ajuste conforme necessário.
# ================================================================

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gruahub
DB_USER=gruahub
DB_PASSWORD=gruahub

# Keycloak
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=gruahub
KEYCLOAK_CLIENT_ID=gruahub-backend
KEYCLOAK_CLIENT_SECRET=gruahub-backend-secret

# MQTT / EMQX
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_USERNAME=gruahub-backend
MQTT_PASSWORD=gruahub-backend-pass
MQTT_HEARTBEAT_TIMEOUT_SECONDS=120

# MinIO
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gruahub

# Frontend
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=gruahub-nextauth-secret-local-only
NEXT_PUBLIC_API_URL=http://localhost:8080
KEYCLOAK_ISSUER=http://localhost:8180/realms/gruahub
KEYCLOAK_CLIENT_ID_WEB=gruahub-web
KEYCLOAK_CLIENT_SECRET_WEB=gruahub-web-secret

# OpenTelemetry (opcional)
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
