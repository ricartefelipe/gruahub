# Copie para .env (ou exporte no shell) antes de `npx expo start`.
# Emulador Android / iOS Simulator / web: localhost funciona.
# Device físico na mesma rede: use o IP da máquina host (ex.: 192.168.15.15).

EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_KEYCLOAK_URL=http://localhost:8180
EXPO_PUBLIC_KEYCLOAK_REALM=gruahub
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=gruahub-mobile

# Exemplo device físico:
# EXPO_PUBLIC_API_URL=http://192.168.15.15:8080
# EXPO_PUBLIC_KEYCLOAK_URL=http://192.168.15.15:8180
