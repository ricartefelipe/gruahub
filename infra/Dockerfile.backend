# ================================================================
# GruaHub Backend — Dockerfile RUNTIME apenas
#
# IMPORTANTE: o JAR deve ser compilado no host antes de usar este
# Dockerfile. Use o script infra/run.ps1 ou compile manualmente:
#   cd backend && mvn package -DskipTests
#
# O motivo: Java TLS (JSSE) não consegue baixar artefatos Maven
# quando há inspeção SSL ativa no host (antivírus, VPN, etc.).
# Maven no host Windows funciona normalmente.
# ================================================================
FROM eclipse-temurin:21-jre-alpine

# Usuário não-root
RUN addgroup -S gruahub && adduser -S gruahub -G gruahub
USER gruahub

WORKDIR /app

# Copia artefato Quarkus pré-compilado pelo host
# (build context é ../backend conforme docker-compose.yml)
COPY --chown=gruahub:gruahub target/quarkus-app/ ./

EXPOSE 8080
STOPSIGNAL SIGTERM

ENV JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseG1GC"

ENTRYPOINT ["sh", "-c", \
    "java $JAVA_OPTS \
     -Djava.util.logging.manager=org.jboss.logmanager.LogManager \
     -jar quarkus-run.jar"]
